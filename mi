<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moje Knihovna & Čtenářský deník</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#fcfaf7',
                        'paper-dark': '#f3eee7',
                        book: '#8c2d19',
                        'book-hover': '#702212',
                        accent: '#d4a373',
                        ink: '#2b2d42',
                        'ink-muted': '#6c757d'
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #fcfaf7;
            color: #2b2d42;
            font-family: 'Inter', sans-serif;
        }
        .book-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .book-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f3eee7;
        }
        ::-webkit-scrollbar-thumb {
            background: #d4a373;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8c2d19;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 bg-stone-900 text-white px-5 py-3 rounded-xl shadow-2xl z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-3">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toast-message" class="text-sm font-medium">Zpráva...</span>
    </div>

    <!-- Header Navigation -->
    <header class="bg-paper-dark border-b border-stone-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <!-- Brand -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchNavTab('library')">
                <i class="fa-solid fa-book-bookmark text-book text-3xl"></i>
                <div>
                    <h1 class="font-serif text-2xl font-bold text-book tracking-tight">Osobní Knihovna</h1>
                    <p class="text-xs text-ink-muted">Čtenářský deník & Seznam přání</p>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="flex items-center gap-2 sm:gap-3 w-full md:w-auto justify-between sm:justify-end flex-wrap">
                <button onclick="switchNavTab('library')" id="nav-library" class="px-3.5 py-2 rounded-lg font-medium text-xs sm:text-sm transition bg-book text-white shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-books"></i> Moje Knihy
                </button>
                <button onclick="openAddModal()" class="px-3.5 py-2 bg-amber-700 hover:bg-amber-800 text-white rounded-lg font-medium text-xs sm:text-sm transition shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> Přidat knihu
                </button>
                <button onclick="switchNavTab('android-guide')" id="nav-guide" class="px-3 py-2 bg-stone-200 hover:bg-stone-300 text-ink rounded-lg font-medium text-xs sm:text-sm transition flex items-center gap-1.5" title="Jak převést na Android aplikaci">
                    <i class="fa-brands fa-android text-emerald-600 text-lg"></i>
                    <span class="hidden sm:inline">Návod Android</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl mx-auto px-4 py-6 flex-grow w-full">

        <!-- VIEW 1: MAIN LIBRARY -->
        <section id="view-library" class="space-y-6">

            <!-- Primary Reading Status Tabs (Přečtené vs. Chci si přečíst) -->
            <div class="flex flex-col sm:flex-row gap-4 justify-between items-center bg-white p-2 sm:p-3 rounded-2xl border border-stone-200 shadow-sm">
                <div class="flex bg-stone-100 p-1 rounded-xl w-full sm:w-auto">
                    <button id="status-tab-read" onclick="setReadingStatusFilter('READ')" class="flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 bg-white text-book shadow-sm">
                        <i class="fa-solid fa-check-circle text-emerald-600"></i> Přečtené knihy (<span id="count-read">0</span>)
                    </button>
                    <button id="status-tab-wish" onclick="setReadingStatusFilter('WISH')" class="flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-stone-600 hover:text-ink">
                        <i class="fa-solid fa-bookmark text-amber-500"></i> Chci si přečíst (<span id="count-wish">0</span>)
                    </button>
                </div>

                <!-- Stats summary -->
                <div class="flex items-center gap-4 text-xs sm:text-sm text-ink-muted px-3">
                    <span><i class="fa-solid fa-book-open text-book mr-1"></i> Celkem: <strong id="stat-count" class="text-ink">0</strong></span>
                    <span>•</span>
                    <span><i class="fa-solid fa-star text-amber-500 mr-1"></i> Průměrné hodnocení: <strong id="stat-rating" class="text-ink">0.0</strong></span>
                </div>
            </div>

            <!-- Toolbar: Search & View options -->
            <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm flex flex-col md:flex-row gap-4 justify-between items-center">
                <!-- Search Input -->
                <div class="relative w-full md:w-96">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400"></i>
                    <input type="text" id="search-input" oninput="handleSearch()" placeholder="Hledat knihu nebo autora..." class="w-full pl-10 pr-4 py-2 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-book focus:border-transparent text-sm">
                </div>

                <!-- Toggle A-Z grouping -->
                <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                    <label class="inline-flex items-center cursor-pointer text-xs font-semibold text-stone-600">
                        <input type="checkbox" id="toggle-grouping" checked onchange="renderBooks()" class="sr-only peer">
                        <div class="relative w-9 h-5 bg-stone-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-stone-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-book"></div>
                        <span class="ms-2">Seskupit od A do Z</span>
                    </label>
                </div>
            </div>

            <!-- Alphabet Quick-Jump Bar (Visible when grouping is active) -->
            <div id="alphabet-bar" class="flex flex-wrap justify-center gap-1.5 p-3 bg-paper-dark rounded-xl border border-stone-200 text-xs font-semibold text-stone-600">
                <!-- Dynamically populated letters -->
            </div>

            <!-- Empty State Display -->
            <div id="empty-state" class="hidden text-center py-16 px-4 bg-white rounded-2xl border border-dashed border-stone-300 my-8">
                <i class="fa-solid fa-book-open text-5xl text-stone-300 mb-3"></i>
                <h3 id="empty-title" class="text-lg font-serif font-semibold text-ink mb-1">Žádné knihy nenalezeny</h3>
                <p id="empty-desc" class="text-ink-muted text-sm max-w-md mx-auto mb-6">Zatiaľ nemáte uloženy žádné knihy v téhle kategorii.</p>
                <button onclick="openAddModal()" class="px-5 py-2.5 bg-book text-white rounded-lg font-medium text-sm hover:bg-book-hover transition shadow">
                    Přidat knihu
                </button>
            </div>

            <!-- Books Container -->
            <div id="books-container" class="space-y-8">
                <!-- JS will inject A-Z grouped sections or plain grid here -->
            </div>
        </section>

        <!-- VIEW 2: ANDROID CONVERSION GUIDE -->
        <section id="view-android-guide" class="hidden space-y-6">
            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm">
                <div class="flex items-center gap-3 border-b border-stone-200 pb-4 mb-6">
                    <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600 text-2xl">
                        <i class="fa-brands fa-android"></i>
                    </div>
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-ink">Návod: Jak vytvořit Android aplikaci (.APK)</h2>
                        <p class="text-sm text-ink-muted">Přehledný návod, jak tento projekt spustit přímo v telefonu jako nativní aplikaci</p>
                    </div>
                </div>

                <div class="space-y-8 text-sm leading-relaxed text-ink">
                    <!-- Method 1 -->
                    <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 space-y-3">
                        <span class="inline-block px-2.5 py-1 bg-emerald-600 text-white font-bold text-xs rounded-md uppercase">Možnost 1: Bez programování (WebIntoApp)</span>
                        <h3 class="font-serif text-lg font-semibold text-book">Použití online konvertoru do APK za 3 minuty</h3>
                        <p>Nejsnazší cesta, pokud nechcete instalovat vývojářské nástroje do PC:</p>
                        <ol class="list-decimal pl-5 space-y-1.5 text-stone-700">
                            <li>Uložte tento HTML soubor na svůj webový hosting nebo bezplatný <strong>GitHub Pages</strong> či <strong>Netlify</strong>.</li>
                            <li>Otevřete stránku <a href="https://www.webintoapp.com/" target="_blank" class="text-book font-semibold underline">WebIntoApp.com</a> nebo <a href="https://gonative.io/" target="_blank" class="text-book font-semibold underline">Median.co</a>.</li>
                            <li>Vložte URL adresu vaší živé stránky.</li>
                            <li>Zadejte název aplikace "Čtenářský Deník" a nahrajte ikonu.</li>
                            <li>Stáhněte si hotový soubor <strong>.APK</strong> přímo do svého mobilního telefonu a nainstalujte.</li>
                        </ol>
                    </div>

                    <!-- Method 2 -->
                    <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 space-y-3">
                        <span class="inline-block px-2.5 py-1 bg-blue-600 text-white font-bold text-xs rounded-md uppercase">Možnost 2: Android Studio (WebView Wrapper)</span>
                        <h3 class="font-serif text-lg font-semibold text-book">Zabalení do Android Studia zdarma a offline</h3>
                        <p>Tento způsob zabalí HTML/JS kód přímo do APK balíčku. Aplikace potom funguje 100% offline bez potřeby internetu.</p>
                        <ol class="list-decimal pl-5 space-y-2 text-stone-700">
                            <li>Nainstalujte si oficiální <strong>Android Studio</strong>.</li>
                            <li>Zvolte nový projekt <strong>"Empty Activity"</strong>.</li>
                            <li>Složku s tímto HTML souborem zkopírujte do: <code class="bg-stone-200 px-1.5 py-0.5 rounded text-xs font-mono">app/src/main/assets/index.html</code></li>
                            <li>Do souboru <code class="bg-stone-200 px-1.5 py-0.5 rounded text-xs font-mono">activity_main.xml</code> vložte prvek:
                                <pre class="bg-stone-800 text-stone-100 p-3 rounded-lg text-xs overflow-x-auto my-2 font-mono">&lt;WebView
    android:id="@+id/webView"
    android:layout_width="match_parent"
    android:layout_height="match_parent" /&gt;</pre>
                            </li>
                            <li>V <code class="bg-stone-200 px-1.5 py-0.5 rounded text-xs font-mono">MainActivity.kt</code> načtěte soubor:
                                <pre class="bg-stone-800 text-stone-100 p-3 rounded-lg text-xs overflow-x-auto my-2 font-mono">val webView = findViewById&lt;WebView&gt;(R.id.webView)
webView.settings.javaScriptEnabled = true
webView.settings.domStorageEnabled = true // Důležité pro ukládání knih!
webView.loadUrl("file:///android_asset/index.html")</pre>
                            </li>
                            <li>Zvolte <strong>Build &gt; Build APK</strong> a získejte soubor pro svůj telefon.</li>
                        </ol>
                    </div>
                </div>

                <div class="mt-8 pt-4 border-t border-stone-200 text-center">
                    <button onclick="switchNavTab('library')" class="px-6 py-2.5 bg-book hover:bg-book-hover text-white font-medium rounded-lg shadow-sm transition">
                        Zpět do Moje Knihy
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-paper-dark border-t border-stone-200 py-4 mt-8 text-center text-xs text-ink-muted">
        <p>Osobní Čtenářský Deník • Všechna data zůstávají bezpečně ve vašem zařízení (LocalStorage)</p>
    </footer>

    <!-- MODAL: ADD / EDIT BOOK -->
    <div id="book-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-stone-200 p-6 space-y-4">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <h3 id="modal-title" class="font-serif text-xl font-bold text-book">Přidat knihu</h3>
                <button onclick="closeModal()" class="text-stone-400 hover:text-stone-700 text-2xl font-bold p-1">&times;</button>
            </div>

            <form id="book-form" onsubmit="handleSaveBook(event)" class="space-y-4">
                <input type="hidden" id="book-id">

                <!-- Reading Status Selection -->
                <div>
                    <label class="block text-xs font-semibold text-stone-700 uppercase mb-1">Stav knihy <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex items-center justify-center gap-2 p-2.5 border rounded-xl cursor-pointer text-xs font-semibold transition border-stone-300 peer-checked:border-book" id="label-status-read">
                            <input type="radio" name="form-status" value="READ" checked onchange="toggleStatusFormFields()" class="text-book focus:ring-book">
                            <span><i class="fa-solid fa-check text-emerald-600 mr-1"></i> Přečteno</span>
                        </label>
                        <label class="flex items-center justify-center gap-2 p-2.5 border rounded-xl cursor-pointer text-xs font-semibold transition border-stone-300" id="label-status-wish">
                            <input type="radio" name="form-status" value="WISH" onchange="toggleStatusFormFields()" class="text-book focus:ring-book">
                            <span><i class="fa-solid fa-bookmark text-amber-500 mr-1"></i> Chci si přečíst</span>
                        </label>
                    </div>
                </div>

                <!-- Title -->
                <div>
                    <label class="block text-xs font-semibold text-stone-700 uppercase mb-1">Název knihy <span class="text-red-500">*</span></label>
                    <input type="text" id="form-title" required placeholder="např. Malý princ, Duna..." class="w-full px-3 py-2 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-book focus:outline-none">
                </div>

                <!-- Author -->
                <div>
                    <label class="block text-xs font-semibold text-stone-700 uppercase mb-1">Autor</label>
                    <input type="text" id="form-author" placeholder="např. Antoine de Saint-Exupéry" class="w-full px-3 py-2 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-book focus:outline-none">
                </div>

                <!-- Rating Section (Only for READ books) -->
                <div id="section-rating">
                    <label class="block text-xs font-semibold text-stone-700 uppercase mb-1">Moje Hodnocení</label>
                    <div class="flex items-center gap-2 text-2xl text-amber-400" id="star-rating-picker">
                        <i class="fa-solid fa-star cursor-pointer hover:scale-110 transition" onclick="setRating(1)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:scale-110 transition" onclick="setRating(2)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:scale-110 transition" onclick="setRating(3)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:scale-110 transition" onclick="setRating(4)"></i>
                        <i class="fa-solid fa-star cursor-pointer hover:scale-110 transition" onclick="setRating(5)"></i>
                        <span id="rating-value-label" class="text-xs font-medium text-stone-500 ml-2">(5 / 5)</span>
                    </div>
                    <input type="hidden" id="form-rating" value="5">
                </div>

                <!-- Notes / Wish rationale -->
                <div>
                    <label id="label-notes" class="block text-xs font-semibold text-stone-700 uppercase mb-1">Moje poznámky & Recenze</label>
                    <textarea id="form-notes" rows="3" placeholder="Co se vám na knize líbilo nebo proč si ji chcete přečíst..." class="w-full px-3 py-2 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-book focus:outline-none"></textarea>
                </div>

                <!-- Cover Image Selection -->
                <div>
                    <label class="block text-xs font-semibold text-stone-700 uppercase mb-1">Fotka obálky</label>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <label class="cursor-pointer bg-stone-100 hover:bg-stone-200 border border-stone-300 px-3 py-2 rounded-lg text-xs font-medium text-stone-700 flex items-center gap-2 transition">
                                <i class="fa-solid fa-upload"></i> Nahrát z fotogalerie
                                <input type="file" id="form-file-input" accept="image/*" class="hidden" onchange="handleFileUpload(event)">
                            </label>
                            <span class="text-xs text-stone-400">nebo ukázková:</span>
                        </div>

                        <!-- Preset Images -->
                        <div class="grid grid-cols-4 gap-2 pt-1" id="preset-covers">
                            <!-- Preset options injected by JS -->
                        </div>

                        <!-- Image Preview -->
                        <div id="image-preview-container" class="mt-2 relative w-20 h-28 rounded border border-stone-300 overflow-hidden hidden">
                            <img id="image-preview" src="" alt="Náhled obálky" class="w-full h-full object-cover">
                            <button type="button" onclick="clearImage()" class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs shadow" title="Odstranit obrázek">&times;</button>
                        </div>
                        <input type="hidden" id="form-image-data">
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end gap-3 border-t border-stone-200 pt-4 mt-6">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 border border-stone-300 text-stone-600 rounded-lg text-sm font-medium hover:bg-stone-100 transition">Zrušit</button>
                    <button type="submit" class="px-5 py-2 bg-book hover:bg-book-hover text-white rounded-lg text-sm font-medium shadow-sm transition">Uložit knihu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: BOOK DETAILS VIEW & SHARE -->
    <div id="detail-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-stone-200 p-6 space-y-6">
            <div class="flex justify-between items-start border-b border-stone-200 pb-4">
                <div>
                    <div id="detail-status-badge" class="mb-1"></div>
                    <h2 id="detail-title" class="font-serif text-2xl font-bold text-book">--</h2>
                    <p id="detail-author" class="text-sm font-medium text-stone-500">--</p>
                </div>
                <button onclick="closeDetailModal()" class="text-stone-400 hover:text-stone-700 text-2xl font-bold">&times;</button>
            </div>

            <div class="flex flex-col sm:flex-row gap-6">
                <!-- Large Cover Image -->
                <div class="w-full sm:w-48 shrink-0 flex flex-col items-center">
                    <img id="detail-cover" src="" alt="Obálka" class="w-44 h-60 object-cover rounded-lg shadow-md border border-stone-200">
                    <div id="detail-rating" class="flex gap-1 text-amber-400 text-lg mt-3">
                        <!-- Stars -->
                    </div>
                </div>

                <!-- Notes & Details -->
                <div class="flex-grow space-y-4">
                    <div>
                        <h4 class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Osobní poznámky & Recenze</h4>
                        <div id="detail-notes" class="bg-paper p-4 rounded-xl border border-stone-200 text-sm leading-relaxed text-ink whitespace-pre-wrap italic">
                            Žádné poznámky nebyly přidány.
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-2 pt-2">
                        <div class="text-xs text-stone-400">
                            Datum přidání: <span id="detail-date">--</span>
                        </div>

                        <!-- Mark as read quick action button for wish items -->
                        <button id="btn-mark-as-read" class="hidden px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-check"></i> Označit jako přečtenou
                        </button>
                    </div>
                </div>
            </div>

            <!-- Share Options Area -->
            <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 space-y-3">
                <span class="text-xs font-bold text-stone-500 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fa-solid fa-share-nodes text-book"></i> Sdílet knihu s přáteli
                </span>
                <div class="flex flex-wrap gap-2">
                    <button id="btn-share-native" onclick="shareBookNative()" class="px-3.5 py-2 bg-book hover:bg-book-hover text-white rounded-lg text-xs font-medium transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i> Sdílet přes aplikaci (Messenger, WhatsApp...)
                    </button>
                    <button onclick="shareBookWhatsApp()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-brands fa-whatsapp text-sm"></i> WhatsApp
                    </button>
                    <button onclick="shareBookTelegram()" class="px-3.5 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded-lg text-xs font-medium transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-brands fa-telegram text-sm"></i> Telegram
                    </button>
                    <button onclick="copyShareTextToClipboard()" class="px-3.5 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 rounded-lg text-xs font-medium transition flex items-center gap-1.5">
                        <i class="fa-solid fa-copy"></i> Zkopírovat text
                    </button>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="flex justify-between items-center border-t border-stone-200 pt-4">
                <button id="detail-delete-btn" class="px-3 py-1.5 text-red-600 hover:bg-red-50 rounded-lg text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-trash"></i> Smazat knihu
                </button>
                <div class="flex gap-2">
                    <button id="detail-edit-btn" class="px-4 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 rounded-lg text-sm font-medium transition flex items-center gap-1.5">
                        <i class="fa-solid fa-pen-to-square"></i> Upravit
                    </button>
                    <button onclick="closeDetailModal()" class="px-4 py-2 bg-book hover:bg-book-hover text-white rounded-lg text-sm font-medium transition">
                        Zavřít
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Preset sample covers
        const PRESET_COVERS = [
            'https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=400&q=80',
            'https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=400&q=80',
            'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80',
            'https://images.unsplash.com/photo-1532012197267-da84d127e765?auto=format&fit=crop&w=400&q=80'
        ];

        // Pre-populated initial sample books
        const SAMPLE_BOOKS = [
            {
                id: '1',
                title: '1984',
                author: 'George Orwell',
                status: 'READ',
                rating: 5,
                notes: 'Fascinující i děsivá vize dystopické budoucnosti. Myšlenky o doublethinku jsou až mrazivě aktuální.',
                cover: 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80',
                createdAt: new Date().toLocaleDateString('cs-CZ')
            },
            {
                id: '2',
                title: 'Alchymista',
                author: 'Paulo Coelho',
                status: 'READ',
                rating: 4,
                notes: 'Krásný filozofický příběh o následování svých snů a naslouchání vlastnímu srdci.',
                cover: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=400&q=80',
                createdAt: new Date().toLocaleDateString('cs-CZ')
            },
            {
                id: '3',
                title: 'Duna',
                author: 'Frank Herbert',
                status: 'READ',
                rating: 5,
                notes: 'Mistrovské sci-fi z pouštní planety Arrakis.',
                cover: 'https://images.unsplash.com/photo-1532012197267-da84d127e765?auto=format&fit=crop&w=400&q=80',
                createdAt: new Date().toLocaleDateString('cs-CZ')
            },
            {
                id: '4',
                title: 'Konec civilizace',
                author: 'Aldous Huxley',
                status: 'WISH',
                rating: 5,
                notes: 'Doporučil mi kamarád jako skvělé doplnění k 1984.',
                cover: 'https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=400&q=80',
                createdAt: new Date().toLocaleDateString('cs-CZ')
            },
            {
                id: '5',
                title: 'Problém tří těles',
                author: 'Cchao Cchı-sin',
                status: 'WISH',
                rating: 5,
                notes: 'Světoznámé sci-fi o prvním kontaktu s mimozemskou civilizací.',
                cover: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=400&q=80',
                createdAt: new Date().toLocaleDateString('cs-CZ')
            }
        ];

        // State variables
        let books = [];
        let currentStatusFilter = 'READ'; // 'READ' or 'WISH'
        let currentNavTab = 'library';
        let currentSearchQuery = '';
        let activeBookForShare = null;

        // Initialize application on page load
        window.addEventListener('DOMContentLoaded', () => {
            loadBooksFromStorage();
            setupPresetPicker();
            renderAlphabetBar();
            renderBooks();
        });

        function loadBooksFromStorage() {
            const stored = localStorage.getItem('my_reading_journal_v2');
            if (stored) {
                try {
                    books = JSON.parse(stored);
                } catch (e) {
                    console.error('Chyba při načítání LocalStorage', e);
                    books = [...SAMPLE_BOOKS];
                }
            } else {
                books = [...SAMPLE_BOOKS];
                saveBooksToStorage();
            }
        }

        function saveBooksToStorage() {
            localStorage.setItem('my_reading_journal_v2', JSON.stringify(books));
        }

        // Toast notifications
        function showToast(message, isSuccess = true) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = message;
            if (isSuccess) {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-amber-400 text-lg";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Navigation Switching
        function switchNavTab(tabName) {
            currentNavTab = tabName;
            document.getElementById('view-library').classList.toggle('hidden', tabName !== 'library');
            document.getElementById('view-android-guide').classList.toggle('hidden', tabName !== 'android-guide');

            const libBtn = document.getElementById('nav-library');
            const guideBtn = document.getElementById('nav-guide');

            if (tabName === 'library') {
                libBtn.className = "px-3.5 py-2 rounded-lg font-medium text-xs sm:text-sm transition bg-book text-white shadow-sm flex items-center gap-2";
                guideBtn.className = "px-3 py-2 bg-stone-200 hover:bg-stone-300 text-ink rounded-lg font-medium text-xs sm:text-sm transition flex items-center gap-1.5";
            } else {
                libBtn.className = "px-3.5 py-2 rounded-lg font-medium text-xs sm:text-sm transition bg-stone-200 hover:bg-stone-300 text-ink shadow-sm flex items-center gap-2";
                guideBtn.className = "px-3 py-2 bg-emerald-600 text-white rounded-lg font-medium text-xs sm:text-sm transition flex items-center gap-1.5";
            }
        }

        // Status Filtering ("Přečtené" vs "Chci si přečíst")
        function setReadingStatusFilter(status) {
            currentStatusFilter = status;
            
            const btnRead = document.getElementById('status-tab-read');
            const btnWish = document.getElementById('status-tab-wish');

            if (status === 'READ') {
                btnRead.className = "flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 bg-white text-book shadow-sm";
                btnWish.className = "flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-stone-600 hover:text-ink";
            } else {
                btnWish.className = "flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 bg-white text-book shadow-sm";
                btnRead.className = "flex-1 sm:flex-none px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-stone-600 hover:text-ink";
            }

            renderBooks();
        }

        // Alphabet Quick Bar
        function renderAlphabetBar() {
            const bar = document.getElementById('alphabet-bar');
            const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
            
            let html = `<button onclick="scrollToSection('all')" class="px-2 py-1 rounded hover:bg-stone-300 transition">Vše</button>`;
            
            alphabet.forEach(letter => {
                html += `<button onclick="scrollToSection('sec-${letter}')" class="px-1.5 py-1 rounded hover:bg-book hover:text-white transition font-mono">${letter}</button>`;
            });

            bar.innerHTML = html;
        }

        function scrollToSection(id) {
            if (id === 'all') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }
            const el = document.getElementById(id);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Main Book Rendering Engine
        function renderBooks() {
            const container = document.getElementById('books-container');
            const emptyState = document.getElementById('empty-state');
            const isGrouped = document.getElementById('toggle-grouping').checked;

            // Counts
            const readCount = books.filter(b => (b.status || 'READ') === 'READ').length;
            const wishCount = books.filter(b => b.status === 'WISH').length;
            document.getElementById('count-read').innerText = readCount;
            document.getElementById('count-wish').innerText = wishCount;

            // Filter by current active status and search text
            const filtered = books.filter(b => {
                const bookStatus = b.status || 'READ';
                if (bookStatus !== currentStatusFilter) return false;

                const q = currentSearchQuery.toLowerCase().trim();
                return b.title.toLowerCase().includes(q) || (b.author && b.author.toLowerCase().includes(q));
            });

            // Update Header Stats
            document.getElementById('stat-count').innerText = filtered.length;
            const readBooks = books.filter(b => (b.status || 'READ') === 'READ');
            const avgRating = readBooks.length > 0 ? (readBooks.reduce((acc, b) => acc + Number(b.rating || 5), 0) / readBooks.length).toFixed(1) : "0.0";
            document.getElementById('stat-rating').innerText = avgRating;

            // Handle empty state
            if (filtered.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                
                if (currentStatusFilter === 'READ') {
                    document.getElementById('empty-title').innerText = "Žádné přečtené knihy";
                    document.getElementById('empty-desc').innerText = "V tomto seznamu zatím nemáte žádné knihy. Přidejte první přečtenou knihu!";
                } else {
                    document.getElementById('empty-title').innerText = "Seznam přání je prázdný";
                    document.getElementById('empty-desc').innerText = "Zatím jste si neuložili žádné knihy, které si chcete v budoucnu přečíst.";
                }
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            // Render A-Z Grouped or Simple Grid
            if (isGrouped) {
                document.getElementById('alphabet-bar').classList.remove('hidden');
                
                const groups = {};
                filtered.forEach(book => {
                    let firstChar = book.title.trim().charAt(0).toUpperCase();
                    firstChar = firstChar.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                    if (!/[A-Z]/.test(firstChar)) firstChar = '#';

                    if (!groups[firstChar]) groups[firstChar] = [];
                    groups[firstChar].push(book);
                });

                const sortedLetters = Object.keys(groups).sort();
                let html = '';

                sortedLetters.forEach(letter => {
                    groups[letter].sort((a, b) => a.title.localeCompare(b.title, 'cs'));

                    html += `
                        <div id="sec-${letter}" class="space-y-3 pt-2">
                            <div class="flex items-center gap-3 border-b-2 border-stone-200 pb-1">
                                <span class="w-8 h-8 bg-book text-white font-serif font-bold text-lg rounded-lg flex items-center justify-center">${letter}</span>
                                <span class="text-xs font-semibold text-stone-400">(${groups[letter].length})</span>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6">
                                ${groups[letter].map(book => createBookCardHtml(book)).join('')}
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;

            } else {
                document.getElementById('alphabet-bar').classList.add('hidden');
                filtered.sort((a, b) => a.title.localeCompare(b.title, 'cs'));

                container.innerHTML = `
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6">
                        ${filtered.map(book => createBookCardHtml(book)).join('')}
                    </div>
                `;
            }
        }

        // Generate Card HTML
        function createBookCardHtml(book) {
            const isRead = (book.status || 'READ') === 'READ';
            
            const stars = Array.from({length: 5}, (_, i) => 
                `<i class="fa-solid fa-star ${i < (book.rating || 5) ? 'text-amber-400' : 'text-stone-300'} text-xs"></i>`
            ).join('');

            const coverUrl = book.cover || 'https://placehold.co/400x600/f3eee7/8c2d19?text=Bez+Obalky';

            return `
                <div onclick="openDetailModal('${book.id}')" class="book-card bg-white rounded-xl border border-stone-200 overflow-hidden cursor-pointer flex flex-col justify-between shadow-sm relative group">
                    <div class="aspect-[2/3] w-full bg-stone-100 relative overflow-hidden">
                        <img src="${coverUrl}" alt="${book.title}" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/400x600/f3eee7/8c2d19?text=Obalka'">
                        
                        <!-- Status Badge Overlay -->
                        <div class="absolute top-2 left-2">
                            ${isRead 
                                ? `<span class="bg-emerald-600/90 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow backdrop-blur-sm"><i class="fa-solid fa-check mr-0.5"></i> Přečteno</span>`
                                : `<span class="bg-amber-500/90 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow backdrop-blur-sm"><i class="fa-solid fa-bookmark mr-0.5"></i> Chci si přečíst</span>`
                            }
                        </div>
                    </div>

                    <div class="p-3 flex flex-col flex-grow justify-between space-y-1">
                        <div>
                            <h4 class="font-serif font-bold text-ink text-sm sm:text-base line-clamp-1">${escapeHtml(book.title)}</h4>
                            <p class="text-xs text-stone-500 line-clamp-1">${escapeHtml(book.author || 'Neznámý autor')}</p>
                        </div>
                        
                        <div class="flex items-center justify-between pt-2 border-t border-stone-100">
                            ${isRead ? `<div class="flex gap-0.5">${stars}</div>` : `<span class="text-[11px] text-amber-600 font-medium"><i class="fa-regular fa-clock mr-1"></i> Na seznamu</span>`}
                            <i class="fa-solid fa-chevron-right text-stone-300 text-xs"></i>
                        </div>
                    </div>
                </div>
            `;
        }

        function handleSearch() {
            currentSearchQuery = document.getElementById('search-input').value;
            renderBooks();
        }

        // Modal Logic
        function openAddModal(bookId = null) {
            const modal = document.getElementById('book-modal');
            const form = document.getElementById('book-form');
            form.reset();

            if (bookId) {
                const book = books.find(b => b.id === bookId);
                if (book) {
                    document.getElementById('modal-title').innerText = "Upravit knihu";
                    document.getElementById('book-id').value = book.id;
                    document.getElementById('form-title').value = book.title;
                    document.getElementById('form-author').value = book.author || '';
                    document.getElementById('form-notes').value = book.notes || '';
                    
                    const statusRadios = document.getElementsByName('form-status');
                    statusRadios.forEach(r => r.checked = (r.value === (book.status || 'READ')));
                    
                    setRating(book.rating || 5);
                    if (book.cover) setImagePreview(book.cover);
                    else clearImage();
                }
            } else {
                document.getElementById('modal-title').innerText = "Přidat novou knihu";
                document.getElementById('book-id').value = '';
                
                const statusRadios = document.getElementsByName('form-status');
                statusRadios.forEach(r => r.checked = (r.value === currentStatusFilter));
                
                setRating(5);
                clearImage();
            }

            toggleStatusFormFields();
            modal.classList.remove('hidden');
        }

        function toggleStatusFormFields() {
            const selectedStatus = document.querySelector('input[name="form-status"]:checked').value;
            const ratingSec = document.getElementById('section-rating');
            const notesLabel = document.getElementById('label-notes');

            if (selectedStatus === 'READ') {
                ratingSec.classList.remove('hidden');
                notesLabel.innerText = "Moje poznámky & Recenze";
            } else {
                ratingSec.classList.add('hidden');
                notesLabel.innerText = "Důvod / Proč si chci knihu přečíst";
            }
        }

        function closeModal() {
            document.getElementById('book-modal').classList.add('hidden');
        }

        // Detail Modal
        function openDetailModal(bookId) {
            const book = books.find(b => b.id === bookId);
            if (!book) return;

            activeBookForShare = book;

            document.getElementById('detail-title').innerText = book.title;
            document.getElementById('detail-author').innerText = book.author ? `Autor: ${book.author}` : 'Autor neuveden';
            document.getElementById('detail-notes').innerText = book.notes || 'Žádné poznámky k této knize nebyly zadány.';
            document.getElementById('detail-date').innerText = book.createdAt || 'Neznámé';

            const coverImg = document.getElementById('detail-cover');
            coverImg.src = book.cover || 'https://placehold.co/400x600/f3eee7/8c2d19?text=Bez+Obalky';

            const isRead = (book.status || 'READ') === 'READ';
            const badge = document.getElementById('detail-status-badge');
            const markBtn = document.getElementById('btn-mark-as-read');

            if (isRead) {
                badge.innerHTML = `<span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full"><i class="fa-solid fa-check mr-1"></i> Přečtená kniha</span>`;
                markBtn.classList.add('hidden');
            } else {
                badge.innerHTML = `<span class="bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-full"><i class="fa-solid fa-bookmark mr-1"></i> Chci si přečíst</span>`;
                markBtn.classList.remove('hidden');
                markBtn.onclick = () => markBookAsRead(book.id);
            }

            // Stars
            const starsContainer = document.getElementById('detail-rating');
            if (isRead) {
                starsContainer.classList.remove('hidden');
                starsContainer.innerHTML = Array.from({length: 5}, (_, i) => 
                    `<i class="fa-solid fa-star ${i < (book.rating || 5) ? 'text-amber-400' : 'text-stone-300'}"></i>`
                ).join('');
            } else {
                starsContainer.classList.add('hidden');
            }

            // Action Buttons
            document.getElementById('detail-edit-btn').onclick = () => {
                closeDetailModal();
                openAddModal(book.id);
            };
            document.getElementById('detail-delete-btn').onclick = () => {
                deleteBook(book.id);
            };

            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detail-modal').classList.add('hidden');
            activeBookForShare = null;
        }

        function markBookAsRead(bookId) {
            const book = books.find(b => b.id === bookId);
            if (book) {
                book.status = 'READ';
                saveBooksToStorage();
                renderBooks();
                closeDetailModal();
                showToast(`Kniha "${book.title}" byla přesunuta do přečtených!`);
            }
        }

        // SHARING FUNCTIONALITY
        function getShareText(book) {
            const isRead = (book.status || 'READ') === 'READ';
            let text = `📚 *${book.title}*`;
            if (book.author) text += ` od *${book.author}*\n`;
            else text += `\n`;

            if (isRead) {
                text += `⭐ Hodnocení: ${book.rating || 5}/5 hvězdiček\n`;
            } else {
                text += `📌 Na seznamu knih ke přečtení\n`;
            }

            if (book.notes) {
                text += `💬 Poznámka: "${book.notes}"\n`;
            }

            text += `\nSdíleno z mé aplikace Čtenářský Deník!`;
            return text;
        }

        // Web Share API (Native mobile share drawer for Messenger, WhatsApp, etc.)
        async function shareBookNative() {
            if (!activeBookForShare) return;
            const text = getShareText(activeBookForShare);

            if (navigator.share) {
                try {
                    await navigator.share({
                        title: `Kniha: ${activeBookForShare.title}`,
                        text: text,
                    });
                    showToast("Sdílení proběhlo úspěšně!");
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        copyShareTextToClipboard();
                    }
                }
            } else {
                copyShareTextToClipboard();
            }
        }

        // WhatsApp direct link
        function shareBookWhatsApp() {
            if (!activeBookForShare) return;
            const text = encodeURIComponent(getShareText(activeBookForShare));
            window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
        }

        // Telegram direct link
        function shareBookTelegram() {
            if (!activeBookForShare) return;
            const text = encodeURIComponent(getShareText(activeBookForShare));
            window.open(`https://t.me/share/url?url=&text=${text}`, '_blank');
        }

        // Clipboard Copy fallback
        function copyShareTextToClipboard() {
            if (!activeBookForShare) return;
            const text = getShareText(activeBookForShare);

            // Execute copy
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast("Text knihy byl zkopírován do schránky!");
            } catch (err) {
                showToast("Nepodařilo se zkopírovat text.", false);
            }
            document.body.removeChild(textarea);
        }

        // Rating Star Picker Handler
        function setRating(val) {
            document.getElementById('form-rating').value = val;
            document.getElementById('rating-value-label').innerText = `(${val} / 5)`;
            const stars = document.querySelectorAll('#star-rating-picker i');
            stars.forEach((star, idx) => {
                star.className = idx < val 
                    ? "fa-solid fa-star cursor-pointer hover:scale-110 transition text-amber-400" 
                    : "fa-solid fa-star cursor-pointer hover:scale-110 transition text-stone-300";
            });
        }

        // Preset Cover Options Setup
        function setupPresetPicker() {
            const container = document.getElementById('preset-covers');
            container.innerHTML = PRESET_COVERS.map((url, i) => `
                <div onclick="setImagePreview('${url}')" class="h-16 rounded border border-stone-200 overflow-hidden cursor-pointer hover:opacity-80 transition">
                    <img src="${url}" class="w-full h-full object-cover" alt="Ukázka ${i+1}">
                </div>
            `).join('');
        }

        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (file.size > 3 * 1024 * 1024) {
                alert('Obrázek je příliš velký. Prosíme vyberte soubor do 3 MB.');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                setImagePreview(e.target.result);
            };
            reader.readAsDataURL(file);
        }

        function setImagePreview(url) {
            document.getElementById('form-image-data').value = url;
            document.getElementById('image-preview').src = url;
            document.getElementById('image-preview-container').classList.remove('hidden');
        }

        function clearImage() {
            document.getElementById('form-image-data').value = '';
            document.getElementById('form-file-input').value = '';
            document.getElementById('image-preview-container').classList.add('hidden');
        }

        // Save Book Action
        function handleSaveBook(event) {
            event.preventDefault();

            const id = document.getElementById('book-id').value;
            const status = document.querySelector('input[name="form-status"]:checked').value;
            const title = document.getElementById('form-title').value.trim();
            const author = document.getElementById('form-author').value.trim();
            const rating = parseInt(document.getElementById('form-rating').value, 10) || 5;
            const notes = document.getElementById('form-notes').value.trim();
            const cover = document.getElementById('form-image-data').value;

            if (!title) return;

            if (id) {
                const index = books.findIndex(b => b.id === id);
                if (index !== -1) {
                    books[index] = {
                        ...books[index],
                        status,
                        title,
                        author,
                        rating,
                        notes,
                        cover
                    };
                }
            } else {
                const newBook = {
                    id: Date.now().toString(),
                    status,
                    title,
                    author,
                    rating,
                    notes,
                    cover,
                    createdAt: new Date().toLocaleDateString('cs-CZ')
                };
                books.unshift(newBook);
            }

            saveBooksToStorage();
            renderBooks();
            closeModal();
            showToast(id ? "Kniha byla úspěšně upravena" : "Nová kniha byla přidána do knihovny");
        }

        function deleteBook(id) {
            books = books.filter(b => b.id !== id);
            saveBooksToStorage();
            renderBooks();
            closeDetailModal();
            showToast("Kniha byla smazána", false);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
